{
  "manifest_version": 3,
  "name": "IMIC TrackPost",
  "version": "2.0.0",
  "icons": {
    "16": "src/ext-icon.png",
    "32": "src/ext-icon.png",
    "48": "src/ext-icon.png",
    "128": "src/ext-icon.png"
  },
  "action": { "default_popup": "index.html" },
  "permissions": ["storage", "tabs", "sidePanel", "webRequest", "clipboardWrite"],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background/serviceworker.ts",
    "type": "module"
  },
  "host_permissions": ["https://ems.epost.go.kr/*", "https://icare.post/*", "https://gcss.ipc.be/*"],
  "content_scripts": [
    {
      "matches": ["https://icare.post/*", "https://gcss.ipc.be/*"],
      "js": ["src/background/contentscript.tsx"],
      "run_at": "document_start"
    }
  ]
}
